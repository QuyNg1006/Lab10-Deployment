@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SE Lab 10 - Docker Deployment</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f4f6f8; margin: 0; display: grid; place-items: center; min-height: 100vh; }
        .card { background: #fff; padding: 2rem 2.5rem; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.1); max-width: 560px; }
        h1 { margin-top: 0; color: #0b5cad; }
        code { background: #eef; padding: 2px 6px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Hello from Docker!</h1>
        <p>This ASP.NET Core app is running inside a container.</p>
        <p>Container host name: <code>@Environment.MachineName</code></p>
        <p>Server time (UTC): <code>@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss")</code></p>
        <p>Health check: <a href="/health">/health</a></p>
        <p><small>Replace this project with your Lab 7/8 app: the Dockerfile works the same way.</small></p>
    </div>
</body>
</html>
